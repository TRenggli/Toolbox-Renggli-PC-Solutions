{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toolbox.renggli-solutions.com/schemas/module-manifest.json",
  "title": "Module Manifest",
  "type": "object",
  "required": ["id", "name", "area", "os", "category", "risk", "reversible", "timeout_ms", "output_schema"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "area": { "enum": ["system", "network", "server", "artec"] },
    "os": { "type": "array", "items": { "enum": ["windows", "linux", "macos"] }, "minItems": 1 },
    "category": { "enum": ["diagnostic", "repair", "admin", "production", "baseline"] },
    "risk": { "enum": ["R", "W-R", "W-L", "!"] },
    "reversible": { "type": "boolean" },
    "parameters": { "type": "object" },
    "permissions": { "type": "array", "items": { "type": "string" } },
    "timeout_ms": { "type": "integer", "minimum": 1000 },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "output_schema": { "type": "object" },
    "associated_repair": { "type": ["string", "null"] },
    "remote_support": { "enum": ["none", "readonly", "full"] },
    "rollback_module": { "type": ["string", "null"] },
    "version": { "type": "string" },
    "min_os_version": { "type": "string" },
    "max_os_version": { "type": "string" },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } }
  }
}
